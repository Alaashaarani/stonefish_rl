                    <mesh filename="Resources/data/ds_simple/ds_funnel_x_1.obj" scale="1.0" convex="true"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="Resources/data/ds_simple/ds_funnel_x_1.obj" scale="1.0"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Fiberglass"/>
                <look name="guide"/>
