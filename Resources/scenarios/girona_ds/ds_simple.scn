<?xml version="1.0"?>
<scenario>
    <robot name="$(arg ds_name)" fixed="true" self_collisions="false">
        <base_link name="Base" type="compound" physics="submerged">
			<external_part name="Semi_structure" type="model" physics="submerged" buoyant="false">
				<physical>
					<mesh filename="Resources/data/ds_simple/phy_ds_structure.obj" scale="1.0" convex="true"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</physical>
				<visual>
					<mesh filename="Resources/data/ds_simple/vis_ds_structure.obj" scale="1.0"/>
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				</visual>
				<material name="Aluminium"/>
				<look name="steel"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
			</external_part>
		</base_link>

		<!-- links -->
        <link name="lock1" type="compound" physics="surface">
            <external_part name="lockleft" type="model" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="Resources/data/ds_simple/lock1.obj" scale="1.0"/>
                    <thickness value="0.003"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="Resources/data/ds_simple/lock1.obj" scale="1.0"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Aluminium"/>
                <look name="steel"/>
                <compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            </external_part>
        </link>
        <link name="lock2" type="compound" physics="surface">
            <external_part name="lockright" type="model" physics="submerged" buoyant="false">
                <physical>
                    <mesh filename="Resources/data/ds_simple/lock2.obj" scale="1.0"/>
                    <thickness value="0.003"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="Resources/data/ds_simple/lock2.obj" scale="1.0"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Aluminium"/>
                <look name="steel"/>
                <compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            </external_part>
        </link>

		<!-- vlc definition -->
		<link name="LinkVlc" type="cylinder" physics="submerged">
			<dimensions radius="0.03" height="0.126"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
			<material name="Steel"/>
			<look name="Neutral"/>
		</link>

        <!-- <light name="Spot">
            <specs radius="0.02" cone_angle="20.0" illuminance="500000.0"/>
            <color rgb="0.1 0.1 1.0"/>
            <origin xyz="0.0 0.0 -0.05" rpy="0.0 0.0 0.0"/>
            <link name="LinkVlc"/>
        </light> -->

		<!-- joints -->
        <joint name="lock/lock1" type="prismatic">
            <parent name="Base"/>
            <child name="lock1"/>
            <origin rpy="0.0 0.0 0.0" xyz=" 0.02 0.02 -0.02" />
            <axis xyz="-1.0 0.0 0.0"/>
            <limits min="0" max="0.25"/>
        </joint>
        <joint name="lock/lock2" type="prismatic">
            <parent name="Base"/>
            <child name="lock2"/>
            <origin rpy="0.0 0.0 0.0" xyz=" 0.02 0.01 -0.02" />
            <axis xyz="1.0 0.0 0.0"/>
            <limits min="0" max="0.25"/>
        </joint>
		<joint name="light_joint" type="fixed">
			<parent name="Base"/>
			<child name="LinkVlc"/>
			<origin xyz="-0.875 -0.58 -1.46" rpy="0.0 1.571 -1.46"/>
			<axis xyz="0.0 1.0 0.0"/>
		</joint>
        
        
        <joint name="funnel_joint" type="fixed">
            <parent name="Base"/>
            <child name="funnels"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <axis xyz="1.0 0.0 0.0"/>
        </joint>


        <link name="funnels" type="compound" physics="submerged">
            <!-- x_funnel holder -->
            <external_part name="x_funnel_holder" type="model">
                <physical>
                    <mesh filename="Resources/data/ds_simple/ds_funnel_x_0_phy.obj" scale="1.0" convex="true"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </physical>
                <visual>
                    <mesh filename="Resources/data/ds_simple/ds_funnel_x_0.obj" scale="1.0"/>
                    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
                </visual>
                <material name="Fiberglass"/>
                <look name="guide"/>
                <compound_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </external_part>
            <external_part name="x_funnel_holder2" type="model">
                <physical>
                    <mesh filename="Resources/data/ds_simple/ds_funnel_x_0_phy.obj" scale="1.0" convex="true"/>
                    <origin rpy="0.0 0.0 0.0" xyz=" 0.0 -1.118 0.0"/>
                </physical>
                <visual>
                    <mesh filename="Resources/data/ds_simple/ds_funnel_x_0.obj" scale="1.0"/>
                    <origin rpy="0.0 0.0 0.0" xyz=" 0.0 -1.118 0.0"/>
                </visual>
                <material name="Fiberglass"/>
                <look name="guide"/>
                <compound_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </external_part>

            <!-- x_funnel origin -->
            <external_part name="x_funnel_1" type="model">
